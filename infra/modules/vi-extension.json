      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "extensionType": "microsoft.videoindexer",
        "autoUpgradeMinorVersion": true,
        "releaseTrain": "[parameters('releaseTrain')]",
        "version": "[parameters('version')]",
        "scope": {

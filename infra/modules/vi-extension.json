      "videoIndexer.agents.enabled": "[parameters('agentsEnabled')]",
      "ViAi.mediaServerStreams.enabled": "[string(parameters('mediaServerStreamsEnabled'))]",
      "storage.storageClass": "[parameters('storageClass')]",
      "storage.accessMode": "ReadWriteMany",

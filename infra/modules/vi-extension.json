      "ViAi.LiveSummarization.enabled": "[string(parameters('liveSummarizationEnabled'))]"
    },
    "apimConfigProperties": "[if(and(not(empty(parameters('apimInternalsBaseUrl'))), not(empty(parameters('apimOperationsBaseUrl')))), createObject('videoIndexer.webApi.config.apimInternalsBaseUrl', parameters('apimInternalsBaseUrl'), 'videoIndexer.webApi.config.apimOperationsBaseUrl', parameters('apimOperationsBaseUrl')), createObject())]",
    "extensionConfigProperties": "[union(variables('baseConfigProperties'), variables('apimConfigProperties'))]"
  },
  "resources": [
    {

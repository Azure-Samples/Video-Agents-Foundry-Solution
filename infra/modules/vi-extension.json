      }
    }
  ],
  "outputs": {
    "result": {
      "type": "string",
      "value": "[reference(extensionResourceId(resourceId('Microsoft.Kubernetes/connectedClusters', parameters('arcConnectedClusterName')), 'Microsoft.KubernetesConfiguration/extensions', parameters('extensionName')), '2022-11-01').provisioningState]"
    }
  }
